<?xml version="1.0"?>
<!-- [REQ:AS-06] Minimal Gazebo (gz-sim8 / Harmonic) world for the IPEx sim seam. Lunar gravity,
     a flat regolith ground plane, a low grazing sun, and the gz systems the bridge depends on
     (physics, scene-broadcaster, user-commands, sensors, imu, contacts). The rover model is spawned
     separately from /robot_description (gz_sim.launch.py) so the URDF stays the single source. -->
<sdf version="1.10">
  <world name="stewie_lunar">
    <!-- Moon surface gravity (constants.LUNAR_G_MS2 / ipex_specs.LUNAR_G_MS2 = 1.62 m/s^2, -Z). -->
    <gravity>0 0 -1.62</gravity>
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Grazing south-pole-like sun (low elevation, hard shadows). -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <direction>0.6 0.2 -0.2</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
    </light>

    <!-- Flat compacted-regolith ground plane (collision + low-albedo visual). -->
    <model name="regolith_ground">
      <static>true</static>
      <link name="surface">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.25 0.24 0.23 1</ambient><diffuse>0.30 0.29 0.27 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
