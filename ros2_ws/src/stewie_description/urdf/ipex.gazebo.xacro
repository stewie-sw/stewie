<?xml version="1.0"?>
<!-- [REQ:AS-06] Gazebo (gz-sim8) overlay for the IPEx model. Includes the single-source AS-03 URDF
     and adds ONLY the gz plugins/sensors needed for the sim seam; all gz topic names match
     stewie_bringup/config/gz_bridge.yaml so the ros_gz_bridge wires straight through. The truth pose
     is published by gz's world dynamic_pose (bridged to /stewie/truth/pose only), NOT here. -->
<robot name="ipex" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find stewie_description)/urdf/ipex.urdf.xacro"/>

  <gazebo>
    <!-- 4-wheel skid-steer: front+rear wheels grouped per side (track_gauge 0.3645, r 0.1525). -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.3645</wheel_separation>
      <wheel_radius>0.1525</wheel_radius>
      <max_linear_velocity>0.3</max_linear_velocity>   <!-- ipex_specs.DRIVE_SPEED_MS -->
      <topic>/model/ipex/cmd_vel</topic>
      <odom_topic>/model/ipex/odometry</odom_topic>
      <tf_topic>/model/ipex/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
    </plugin>
  </gazebo>

  <!-- IMU sensor on imu_link -> /model/ipex/imu (no rendering; works headless). -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>/model/ipex/imu</topic>
    </sensor>
  </gazebo>

  <!-- Contact/collision evidence: front-left wheel contact sensor publishes when the rover settles
       onto the regolith plane. gz sdf appends "_collision" to the named URDF collision, so the
       sensor references the generated SDF collision name. It is diagnostics/evidence, not truth. -->
  <gazebo reference="front_left_wheel">
    <sensor name="front_left_wheel_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <contact>
        <collision>front_left_wheel_collision_collision</collision>
        <topic>/model/ipex/contact</topic>
      </contact>
    </sensor>
  </gazebo>

  <!-- [BA-02] the LAC-twin 8-camera rig. Each camera emits its image AND its camera_info (intrinsics +
       extrinsics) so perception can rectify/triangulate. hfov 73.99 deg (profile optics), 1024x768.
       RENDERING needs the sensors system + a GL backend (GPU/EGL headless); the profile's max_live gates
       which are active at runtime, but the description declares the full rig. -->
  <xacro:macro name="gz_camera" params="frame">
    <gazebo reference="camera_${frame}">
      <sensor name="camera_${frame}" type="camera">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/model/ipex/camera/${frame}/image</topic>
        <camera_info_topic>/model/ipex/camera/${frame}/camera_info</camera_info_topic>
        <camera>
          <horizontal_fov>1.2914</horizontal_fov>
          <image><width>1024</width><height>768</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>100.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:gz_camera frame="front_left"/>
  <xacro:gz_camera frame="front_right"/>
  <xacro:gz_camera frame="rear_left"/>
  <xacro:gz_camera frame="rear_right"/>
  <xacro:gz_camera frame="left_mono"/>
  <xacro:gz_camera frame="right_mono"/>
  <xacro:gz_camera frame="drum_front"/>
  <xacro:gz_camera frame="drum_back"/>

  <!-- Selected simulated depth source for AS-06: low-rate front LiDAR-style cloud on the swappable
       range-sensor mount. The no-LiDAR flight profile can still select stereo; this Gazebo source
       gives the sim a concrete PointCloud2 egress without simulator truth. -->
  <gazebo reference="lidar_front_mount">
    <sensor name="lidar_front_points" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>/model/ipex/perception</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>64</samples>
            <resolution>1</resolution>
            <min_angle>-0.785398</min_angle>
            <max_angle>0.785398</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.20</min>
          <max>20.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
