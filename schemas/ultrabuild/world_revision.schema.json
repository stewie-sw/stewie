{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/world_revision.schema.json",
  "title": "STEWIE immutable world-state revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "world_id",
    "site_id",
    "branch_id",
    "parent_revision_ids",
    "state_kind",
    "authority_scope",
    "spatial",
    "valid_time",
    "uncertainty",
    "state_contract_hash",
    "transaction_time",
    "payload_hash",
    "coverage_hash",
    "payload_media_type",
    "payload_byte_size",
    "claim_ids",
    "event_ids",
    "provenance_bundle_id",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.world_revision/1.0"},
    "revision_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "parent_revision_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "state_kind": {
      "enum": [
        "planned",
        "predicted",
        "simulated",
        "observed",
        "proposed",
        "reconciled",
        "verified",
        "authoritative",
        "superseded",
        "archived",
        "reference"
      ]
    },
    "authority_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_mode", "branch_kind", "policy_id", "evaluation_visibility"],
      "properties": {
        "environment_mode": {
          "enum": ["dev", "training", "rehearsal", "live", "replay", "archive"]
        },
        "branch_kind": {
          "enum": ["plan", "prediction", "simulation", "evidence", "belief", "accepted", "evaluation_reference", "archive"]
        },
        "policy_id": {"$ref": "#/$defs/id"},
        "evaluation_visibility": {"enum": ["system_visible", "withheld_reference"]}
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "representation",
        "resolution",
        "crs",
        "frame_id",
        "transform_chain_id",
        "axis_order",
        "bounds",
        "shape",
        "units",
        "extent_hash"
      ],
      "properties": {
        "region_id": {"$ref": "#/$defs/id"},
        "representation": {
          "enum": ["raster_2_5d", "point_set", "mesh", "voxel", "object", "region"]
        },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "crs": {"type": "string", "minLength": 1},
        "frame_id": {"$ref": "#/$defs/id"},
        "transform_chain_id": {"$ref": "#/$defs/id"},
        "axis_order": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "number"}
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "units": {"type": "object", "minProperties": 1},
        "extent_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "state_contract_hash": {"$ref": "#/$defs/sha256"},
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "clock_id", "uncertainty_s"],
      "properties": {
        "start": {"type": "number"},
        "end": {"type": ["number", "null"]},
        "clock_id": {"$ref": "#/$defs/id"},
        "uncertainty_s": {"type": "number", "minimum": 0}
      }
    },
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "payload_hash": {"$ref": "#/$defs/sha256"},
    "coverage_hash": {"$ref": "#/$defs/sha256"},
    "payload_media_type": {"type": "string", "minLength": 1},
    "payload_byte_size": {"type": "integer", "minimum": 0},
    "claim_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "event_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "reconciliation_decision_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_record_hash": {"$ref": "#/$defs/sha256"},
    "prior_head_revision_id": {
      "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "branch_revision_sequence": {"type": "integer", "minimum": 0},
    "supersedes_revision_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true,
      "default": []
    },
    "invalidated_artifact_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true,
      "default": []
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state_kind": {
            "enum": ["reconciled", "verified", "authoritative"]
          }
        },
        "required": ["state_kind"]
      },
      "then": {
        "required": [
          "reconciliation_decision_id",
          "candidate_id",
          "candidate_record_hash",
          "prior_head_revision_id",
          "branch_revision_sequence"
        ],
        "properties": {
          "authority_scope": {
            "properties": {"branch_kind": {"enum": ["belief", "accepted"]}}
          },
          "claim_ids": {"minItems": 1},
          "event_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"state_kind": {"const": "simulated"}},
        "required": ["state_kind"]
      },
      "then": {
        "properties": {
          "authority_scope": {
            "properties": {
              "branch_kind": {"const": "simulation"},
              "environment_mode": {"not": {"const": "live"}},
              "evaluation_visibility": {"const": "system_visible"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_scope": {
            "properties": {"evaluation_visibility": {"const": "withheld_reference"}},
            "required": ["evaluation_visibility"]
          }
        },
        "required": ["authority_scope"]
      },
      "then": {
        "properties": {
          "state_kind": {"const": "reference"},
          "authority_scope": {
            "properties": {
              "branch_kind": {"const": "evaluation_reference"},
              "environment_mode": {"const": "replay"}
            }
          }
        }
      },
      "else": {
        "not": {"properties": {"state_kind": {"const": "reference"}}, "required": ["state_kind"]}
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "components",
        "aggregate_variance_hash",
        "mask_hash",
        "calibration_status"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status", "unit"],
            "properties": {
              "kind": {
                "enum": [
                  "sensor",
                  "localization",
                  "geometric",
                  "material",
                  "temporal",
                  "change_attribution",
                  "model",
                  "inter_robot"
                ]
              },
              "status": {"enum": ["known", "unknown", "not_applicable"]},
              "unit": {"type": "string", "minLength": 1},
              "value": {"type": "number", "minimum": 0},
              "calibration_id": {"$ref": "#/$defs/id"},
              "reason_code": {"$ref": "#/$defs/id"}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "known"}}, "required": ["status"]},
                "then": {"required": ["value", "calibration_id"]},
                "else": {
                  "required": ["reason_code"],
                  "not": {"required": ["value"]}
                }
              }
            ]
          }
        },
        "aggregate_variance_hash": {"$ref": "#/$defs/sha256"},
        "mask_hash": {"$ref": "#/$defs/sha256"},
        "calibration_status": {
          "enum": ["calibrated", "assumed", "unknown", "out_of_domain"]
        }
      }
    }
  }
}
