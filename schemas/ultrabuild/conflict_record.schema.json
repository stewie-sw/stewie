{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/conflict_record.schema.json",
  "title": "STEWIE durable evidence conflict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conflict_id",
    "world_id",
    "site_id",
    "branch_id",
    "claim_ids",
    "reason_codes",
    "spatial_overlap_hash",
    "valid_time",
    "hypothesis_set_id",
    "status",
    "provenance_bundle_id",
    "transaction_time",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.conflict_record/1.0"},
    "conflict_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "claim_ids": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "spatial_overlap_hash": {"$ref": "#/$defs/sha256"},
    "valid_time": {"$ref": "#/$defs/valid_time"},
    "hypothesis_set_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["open", "resolved", "superseded"]},
    "resolution_decision_id": {"$ref": "#/$defs/id"},
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "transaction_time": {"$ref": "#/$defs/transaction_time"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
      "then": {"required": ["resolution_decision_id"]},
      "else": {"not": {"required": ["resolution_decision_id"]}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "clock_id", "uncertainty_s"],
      "properties": {
        "start": {"type": "number"},
        "end": {"type": ["number", "null"]},
        "clock_id": {"$ref": "#/$defs/id"},
        "uncertainty_s": {"type": "number", "minimum": 0}
      }
    },
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
