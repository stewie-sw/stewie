{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/runtime_graph.schema.json",
  "title": "STEWIE runtime operational graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "producer_node",
    "status",
    "authoritative_store",
    "internal_contracts",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {"const": "stewie.runtime_graph/1.0"},
    "artifact_id": {"const": "ART-RUNTIME-GRAPH"},
    "producer_node": {"const": "ARCH-030"},
    "status": {"enum": ["specified", "implemented", "verified", "superseded"]},
    "authoritative_store": {"type": "string", "minLength": 1},
    "internal_contracts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "known_defects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "input_contracts",
          "output_contracts",
          "preconditions",
          "postconditions",
          "timeout_ms",
          "retry_policy",
          "failure_isolation",
          "evidence_generated",
          "permitted_mutations",
          "idempotency_key_required"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^RT-[A-Z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "input_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "output_contracts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "postconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "timeout_ms": {"type": "integer", "minimum": 1},
          "retry_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts", "backoff", "retryable_failures"],
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1},
              "backoff": {"enum": ["none", "bounded_exponential"]},
              "retryable_failures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          },
          "failure_isolation": {"type": "string", "minLength": 1},
          "evidence_generated": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "permitted_mutations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "idempotency_key_required": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer", "consumer", "artifacts", "trigger", "fan_in"],
        "properties": {
          "id": {"type": "string", "pattern": "^RTE-[A-Z0-9-]+$"},
          "producer": {"type": "string", "minLength": 1},
          "consumer": {"type": "string", "minLength": 1},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trigger": {"type": "string", "minLength": 1},
          "fan_in": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "loop_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loop_id",
              "maximum_iterations_source",
              "termination_conditions",
              "improvement_metric"
            ],
            "properties": {
              "loop_id": {"type": "string", "minLength": 1},
              "maximum_iterations_source": {"type": "string", "minLength": 1},
              "termination_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "improvement_metric": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
