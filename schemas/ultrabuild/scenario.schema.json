{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/scenario.schema.json",
  "title": "STEWIE preregistered experiment scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "site_id",
    "domain",
    "research_questions",
    "terrain",
    "robots",
    "candidate_visible_actions",
    "withheld_execution_truth",
    "evidence_sequence",
    "systems",
    "ablations",
    "perturbations",
    "seeds",
    "experimental_units",
    "primary_endpoint",
    "minimum_effect",
    "sample_size_plan",
    "exclusion_rules",
    "stopping_rule",
    "statistical_model",
    "multiplicity_plan",
    "harm_tolerance",
    "metrics",
    "reference_firewall",
    "code_commit"
  ],
  "properties": {
    "schema_version": {"const": "stewie.scenario/1.0"},
    "scenario_id": {"$ref": "#/$defs/sha256"},
    "site_id": {"$ref": "#/$defs/id"},
    "domain": {"enum": ["lunar", "terrestrial"]},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^RQ[1-7]$"},
      "uniqueItems": true
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "content_hash", "crop", "crs", "units", "license_status"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "crop": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "integer"}
        },
        "crs": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "license_status": {"enum": ["verified", "restricted", "unknown"]}
      }
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "candidate_visible_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "content_hash", "mount"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "mount": {"type": "string", "minLength": 1}
      }
    },
    "withheld_execution_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "content_hash", "evaluator_mount"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "evaluator_mount": {"type": "string", "minLength": 1}
      }
    },
    "evidence_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "claim_id", "available_to_candidate", "receipt_delay_s"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "claim_id": {"$ref": "#/$defs/id"},
          "available_to_candidate": {"type": "boolean"},
          "receipt_delay_s": {"type": "number", "minimum": 0}
        }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "ablations": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "perturbations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["levels", "generation_process_id", "oracle_independent_of_estimator"],
        "properties": {
          "levels": {
            "type": "array",
            "minItems": 2,
            "items": {"type": ["number", "string", "boolean"]}
          },
          "generation_process_id": {"$ref": "#/$defs/id"},
          "oracle_independent_of_estimator": {"type": "boolean"}
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    },
    "experimental_units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "unit_ids", "resampling_level"],
      "properties": {
        "unit_kind": {"enum": ["terrain_action_pair", "scenario", "mission_run"]},
        "unit_ids": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "resampling_level": {"enum": ["terrain_action_pair", "scenario", "mission_run"]}
      }
    },
    "primary_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "decision_threshold", "aggregation"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["lower", "higher", "noninferior"]},
        "decision_threshold": {"type": "number"},
        "aggregation": {"type": "string", "minLength": 1}
      }
    },
    "minimum_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "basis"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "basis": {"enum": ["pilot", "domain", "assumed"]}
      }
    },
    "sample_size_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_units", "seeds_per_unit", "power", "alpha", "pilot_scenario_ids"],
      "properties": {
        "independent_units": {"type": "integer", "minimum": 2},
        "seeds_per_unit": {"type": "integer", "minimum": 1},
        "power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "pilot_scenario_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    },
    "exclusion_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "stopping_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "planned_trial_count"],
      "properties": {
        "kind": {"const": "fixed_count"},
        "planned_trial_count": {"type": "integer", "minimum": 2}
      }
    },
    "statistical_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "estimand", "blocking_factors", "interval"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "estimand": {"type": "string", "minLength": 1},
        "blocking_factors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "interval": {"enum": ["confidence", "credible", "bootstrap"]}
      }
    },
    "multiplicity_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "method", "ordered_endpoints"],
      "properties": {
        "family_id": {"$ref": "#/$defs/id"},
        "method": {"enum": ["none_single_primary", "holm", "fixed_sequence", "fdr"]},
        "ordered_endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "harm_tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "values", "basis"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "basis": {"enum": ["sourced", "derived", "calibrated", "assumed"]}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reference_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_process",
        "evaluator_process",
        "candidate_identity",
        "evaluator_identity",
        "separate_credentials",
        "candidate_reference_access",
        "evaluator_reference_access",
        "isolation_mechanism",
        "reference_mount_after_candidate_freeze",
        "candidate_output_freeze_protocol",
        "poison_test_id",
        "poison_attestation_required"
      ],
      "properties": {
        "candidate_process": {"type": "string", "minLength": 1},
        "evaluator_process": {"type": "string", "minLength": 1},
        "candidate_identity": {"$ref": "#/$defs/id"},
        "evaluator_identity": {"$ref": "#/$defs/id"},
        "separate_credentials": {"const": true},
        "candidate_reference_access": {"const": false},
        "evaluator_reference_access": {"const": true},
        "isolation_mechanism": {
          "enum": ["separate_container_mounts", "separate_host_permissions", "remote_evaluator"]
        },
        "reference_mount_after_candidate_freeze": {"const": true},
        "candidate_output_freeze_protocol": {"type": "string", "minLength": 1},
        "poison_test_id": {"$ref": "#/$defs/id"},
        "poison_attestation_required": {"const": true}
      }
    },
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
