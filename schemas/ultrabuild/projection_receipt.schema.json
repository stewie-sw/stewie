{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/projection_receipt.schema.json",
  "title": "STEWIE projection freshness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "store_id",
    "projection_id",
    "requested_sequence",
    "projected_sequence",
    "lag_records",
    "status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "stewie.projection_receipt/1.0"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "store_id": {"$ref": "#/$defs/id"},
    "projection_id": {"$ref": "#/$defs/id"},
    "requested_sequence": {"type": "integer", "minimum": 0},
    "projected_sequence": {"type": "integer", "minimum": 0},
    "lag_records": {"type": "integer", "minimum": 0},
    "status": {"enum": ["fresh", "partial", "stale", "rebuilding"]},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  }
}
