{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/query_request.schema.json",
  "title": "STEWIE immutable world-state query request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "world_id",
    "site_id",
    "branch_id",
    "policy_id",
    "region_id",
    "requested_state_kinds",
    "valid_at",
    "known_at",
    "representation",
    "resolution",
    "frame_id",
    "units",
    "requesting_agent_id",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.query_request/1.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "policy_id": {"$ref": "#/$defs/id"},
    "region_id": {"$ref": "#/$defs/id"},
    "requested_state_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "planned", "predicted", "simulated", "observed", "proposed", "reconciled",
          "verified", "authoritative", "superseded", "archived", "reference"
        ]
      }
    },
    "valid_at": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant", "clock_id", "uncertainty_s"],
      "properties": {
        "instant": {"type": "number"},
        "clock_id": {"$ref": "#/$defs/id"},
        "uncertainty_s": {"type": "number", "minimum": 0}
      }
    },
    "known_at": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "representation": {
      "enum": ["raster_2_5d", "point_set", "mesh", "voxel", "object", "region"]
    },
    "resolution": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "frame_id": {"$ref": "#/$defs/id"},
    "units": {"type": "object", "minProperties": 1},
    "requesting_agent_id": {"$ref": "#/$defs/id"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
