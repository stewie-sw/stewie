{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/append_receipt.schema.json",
  "title": "STEWIE durable append receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "store_id",
    "submission_id",
    "idempotency_key",
    "submission_hash",
    "record_schema",
    "record_id",
    "transaction_time",
    "content_hash",
    "durability",
    "duplicate"
  ],
  "properties": {
    "schema_version": {"const": "stewie.append_receipt/1.0"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "store_id": {"$ref": "#/$defs/id"},
    "submission_id": {"$ref": "#/$defs/id"},
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "submission_hash": {"$ref": "#/$defs/sha256"},
    "record_schema": {"type": "string", "pattern": "^[a-z_]+\\.schema\\.json$"},
    "record_id": {"$ref": "#/$defs/id"},
    "transaction_time": {"$ref": "#/$defs/transaction_time"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["committed", "journal_mode", "synchronous", "schema_version"],
      "properties": {
        "committed": {"const": true},
        "journal_mode": {"const": "wal"},
        "synchronous": {"const": "full"},
        "schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "duplicate": {"type": "boolean"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
