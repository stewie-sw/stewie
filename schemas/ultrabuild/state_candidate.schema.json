{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/state_candidate.schema.json",
  "title": "STEWIE observation-only state candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "world_id",
    "site_id",
    "branch_id",
    "prior_revision_id",
    "admitted_observation_ids",
    "excluded_evidence",
    "payload",
    "construction",
    "policy",
    "dependency_edge_ids",
    "physics_comparison_ids",
    "provenance_bundle_id",
    "transaction_time",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.state_candidate/1.0"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "prior_revision_id": {"$ref": "#/$defs/id"},
    "admitted_observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "excluded_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "reason_code"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"},
          "reason_code": {"$ref": "#/$defs/id"}
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "coverage_hash", "media_type", "byte_size"],
      "properties": {
        "content_hash": {"$ref": "#/$defs/sha256"},
        "coverage_hash": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0}
      }
    },
    "construction": {"const": "plain_mean_of_admissible_observations"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "config_hash"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/id"},
        "config_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependency_edge_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "physics_comparison_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "transaction_time": {"$ref": "#/$defs/transaction_time"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
