{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/supersession_event.schema.json",
  "title": "STEWIE immutable transaction-time supersession event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "world_id",
    "site_id",
    "branch_id",
    "event_kind",
    "target_record_id",
    "reason_codes",
    "evidence_ids",
    "provenance_bundle_id",
    "transaction_time",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.supersession_event/1.0"},
    "event_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "event_kind": {"enum": ["supersede", "invalidate", "archive"]},
    "target_record_id": {"$ref": "#/$defs/id"},
    "successor_record_id": {"$ref": "#/$defs/id"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_kind": {"const": "supersede"}},
        "required": ["event_kind"]
      },
      "then": {"required": ["successor_record_id"]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
