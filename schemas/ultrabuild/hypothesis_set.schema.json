{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/hypothesis_set.schema.json",
  "title": "STEWIE durable competing-hypothesis set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_set_id",
    "world_id",
    "site_id",
    "branch_id",
    "conflict_id",
    "hypotheses",
    "status",
    "provenance_bundle_id",
    "transaction_time",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.hypothesis_set/1.0"},
    "hypothesis_set_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "conflict_id": {"$ref": "#/$defs/id"},
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "claim_ids", "supporting_evidence_ids"],
        "properties": {
          "hypothesis_id": {"$ref": "#/$defs/id"},
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/id"},
            "uniqueItems": true
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/id"},
            "uniqueItems": true
          }
        }
      }
    },
    "status": {"enum": ["open", "resolved", "superseded"]},
    "resolution_decision_id": {"$ref": "#/$defs/id"},
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "transaction_time": {"$ref": "#/$defs/transaction_time"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
      "then": {"required": ["resolution_decision_id"]},
      "else": {"not": {"required": ["resolution_decision_id"]}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
