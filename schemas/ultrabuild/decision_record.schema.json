{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/decision_record.schema.json",
  "title": "STEWIE autonomy decision bound to an exact world-state lens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_record_id",
    "world_id",
    "site_id",
    "mission_id",
    "task_id",
    "robot_id",
    "query_lens_id",
    "world_revision_id",
    "alternatives",
    "constraint_set_hash",
    "selected_action_id",
    "expected_outcome_claim_ids",
    "value_of_information",
    "approval",
    "provenance_bundle_id",
    "transaction_time",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.decision_record/1.0"},
    "decision_record_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "mission_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "robot_id": {"$ref": "#/$defs/id"},
    "query_lens_id": {"$ref": "#/$defs/id"},
    "world_revision_id": {"$ref": "#/$defs/id"},
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "cost_components", "feasible", "reason_codes"],
        "properties": {
          "action_id": {"$ref": "#/$defs/id"},
          "cost_components": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number"}
          },
          "feasible": {"type": "boolean"},
          "reason_codes": {
            "type": "array",
            "items": {"$ref": "#/$defs/id"},
            "uniqueItems": true
          }
        }
      }
    },
    "constraint_set_hash": {"$ref": "#/$defs/sha256"},
    "selected_action_id": {"$ref": "#/$defs/id"},
    "expected_outcome_claim_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "value_of_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "expected_decision_change_probability", "expected_cost"],
      "properties": {
        "decision": {
          "enum": ["act", "rescan", "request_data", "defer", "dispatch_robot", "human_review"]
        },
        "expected_decision_change_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expected_cost": {"type": "number", "minimum": 0}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actor_id", "reason_code"],
      "properties": {
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "actor_id": {"$ref": "#/$defs/id"},
        "reason_code": {"$ref": "#/$defs/id"}
      }
    },
    "provenance_bundle_id": {"$ref": "#/$defs/id"},
    "transaction_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
