{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewie.local/schemas/ultrabuild/query_lens.schema.json",
  "title": "STEWIE immutable world-state query lens",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lens_id",
    "query_request_id",
    "world_id",
    "site_id",
    "branch_id",
    "policy_id",
    "region_id",
    "requested_state_kinds",
    "valid_at",
    "known_at",
    "representation",
    "resolution",
    "frame_id",
    "units",
    "requesting_agent_id",
    "status",
    "reason_codes",
    "available_claim_ids",
    "resolved_revision_id",
    "resolved_state_kind",
    "projection_transaction_sequence",
    "result_coverage_hash",
    "result_payload_hash",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "stewie.query_lens/1.0"},
    "lens_id": {"$ref": "#/$defs/id"},
    "query_request_id": {"$ref": "#/$defs/id"},
    "world_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "branch_id": {"$ref": "#/$defs/id"},
    "policy_id": {"$ref": "#/$defs/id"},
    "region_id": {"$ref": "#/$defs/id"},
    "requested_state_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "planned",
          "predicted",
          "simulated",
          "observed",
          "proposed",
          "reconciled",
          "verified",
          "authoritative",
          "superseded",
          "archived",
          "reference"
        ]
      }
    },
    "valid_at": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant", "clock_id", "uncertainty_s"],
      "properties": {
        "instant": {"type": "number"},
        "clock_id": {"$ref": "#/$defs/id"},
        "uncertainty_s": {"type": "number", "minimum": 0}
      }
    },
    "known_at": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "recorded_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "representation": {
      "enum": ["raster_2_5d", "point_set", "mesh", "voxel", "object", "region"]
    },
    "resolution": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "frame_id": {"$ref": "#/$defs/id"},
    "units": {"type": "object", "minProperties": 1},
    "requesting_agent_id": {"$ref": "#/$defs/id"},
    "status": {
      "enum": ["resolved", "unavailable", "stale_projection", "partial_coverage"]
    },
    "reason_codes": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "available_claim_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "resolved_revision_id": {
      "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "resolved_state_kind": {
      "oneOf": [
        {
          "enum": [
            "planned",
            "predicted",
            "simulated",
            "observed",
            "proposed",
            "reconciled",
            "verified",
            "authoritative",
            "superseded",
            "archived",
            "reference"
          ]
        },
        {"type": "null"}
      ]
    },
    "projection_transaction_sequence": {"type": "integer", "minimum": 0},
    "result_coverage_hash": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "result_payload_hash": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "resolved"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason_codes": {"maxItems": 0},
          "resolved_revision_id": {"$ref": "#/$defs/id"},
          "resolved_state_kind": {
            "enum": [
              "planned",
              "predicted",
              "simulated",
              "observed",
              "proposed",
              "reconciled",
              "verified",
              "authoritative",
              "superseded",
              "archived",
              "reference"
            ]
          },
          "result_coverage_hash": {"$ref": "#/$defs/sha256"},
          "result_payload_hash": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "reason_codes": {"minItems": 1},
          "resolved_revision_id": {"type": "null"},
          "resolved_state_kind": {"type": "null"},
          "result_payload_hash": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["unavailable", "stale_projection"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {"result_coverage_hash": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "partial_coverage"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"result_coverage_hash": {"$ref": "#/$defs/sha256"}}
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
