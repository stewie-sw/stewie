# STEWIE backend — FastAPI mission planner + physics authority (atomic plan B1.1)
# S-13: the base is pinned by DIGEST (not the mutable python:3.12-slim tag) so a rebuild from the same
# revision uses identical bytes. Digest = the python:3.12-slim multi-arch index (Docker Hub, 2026-06-14).
FROM python:3.12-slim@sha256:d764629ce0ddd8c71fd371e9901efb324a95789d2315a47db7e4d27e78f1b0e9 AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    STEWIE_DATA_DIR=/data
WORKDIR /app
# rasterio (#254): its bundled-GDAL manylinux wheel still dynamically links a few base system libs that
# python:3.12-slim omits -- libexpat1 (GDAL's XML drivers). Install it so `import rasterio` works in prod
# (the COG export was honest-503 with "libexpat.so.1: cannot open shared object file" until this).
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
 && rm -rf /var/lib/apt/lists/*
# SEC-05: install the third-party deps from the HASHED lock FIRST (supply-chain integrity + a cached
# layer), then the stewie package itself --no-deps. The lock pins exact versions + sha256 hashes;
# --require-hashes refuses any wheel/sdist whose bytes do not match. Regenerate the lock with:
#   uv pip compile pyproject.toml --extra server --generate-hashes --universal -o requirements-server.lock
COPY pyproject.toml README.md requirements-server.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-server.lock
# O-04: copy each package ONCE (the duplicate `COPY stewie ./stewie` was a wasted layer).
COPY stewie ./stewie
COPY dart ./dart
COPY lode ./lode
COPY leap ./leap
COPY forge ./forge
COPY samples ./samples
COPY validation ./validation
# PO-17: stewie-bodies is a standalone workspace package; stewie/specs/bodies.py is a shim that re-exports it,
# so the package must be installed alongside the root (--no-deps: it is pure-stdlib, no PyPI resolution).
COPY packages ./packages
RUN pip install --no-cache-dir --no-deps packages/stewie-bodies . && useradd -r -u 10001 stewie \
 && mkdir -p /data && chown -R stewie /data \
 && chmod -R a+rX /app
# Docker COPY preserves the source file mode. Generated artifacts (e.g. bodies.json via
# write_json_atomic -> mkstemp 0600) would arrive owner-only and the non-root `stewie` worker could not
# read them -> PermissionError on /plan (read_only rootfs blocks any runtime chmod). a+rX forces every
# served file readable + dirs traversable (mirrors Dockerfile.frontend). atomicio.py also chmods 0644
# at the source; this is defence-in-depth for any other generated/odd-mode file.
USER stewie
EXPOSE 8770
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8770/healthz', timeout=2).status==200 else 1)"
# BP-02: enter the GUARDED entrypoint via `python -m` so the public-bind TLS guard
# (_require_tls_for_public_bind, called only from main()) actually runs in the production image -- a raw
# `uvicorn server:app` imports the ASGI app directly and bypasses main(). `python -m stewie.server.server`
# (NOT the `stewie-serve` console script) is required: `python -m` puts WORKDIR /app on sys.path[0], so the
# app imports from /app -- which carries the web/*.html + samples/ DATA FILES. The installed site-packages
# copy has NO data files, so `stewie-serve` (which imports the installed package) 404s /program and loses
# the Haworth DEM. Single-process (uvicorn.run, no workers) -- consistent with the single-worker invariant.
CMD ["python", "-m", "stewie.server.server", "--host", "0.0.0.0", "--port", "8770"]
