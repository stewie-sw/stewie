# STEWIE deploy environment TEMPLATE. Copy to deploy/.env (gitignored, chmod 600) and fill the SECRETS.
# NEVER commit the real deploy/.env -- it holds live credentials. This template records the non-secret
# config (posture + identity) so a deploy is reproducible.

# --- SECRETS (generate locally; leave blank here) ---
STEWIE_API_KEY=              # automation credential (rotate per OPS-01/02; chmod 600 deploy/.env)
STEWIE_SESSION_SECRET=       # BP-03: standalone session-signing secret, REQUIRED in production.
                             # generate: python -c 'import secrets; print(secrets.token_hex(32))'
                             # (rotating STEWIE_API_KEY leaves live sessions valid; rotating this resets them)

# --- Production posture ---
STEWIE_TLS_TERMINATED=1      # TLS terminated at Cloudflare; backend is internal-only (BP-02 guard)

# --- Identity (BP-04: production REQUIRES an explicit allowlist + directors -- emails are not secret) ---
# operators may sign in (shaped telemetry); directors get full state (truth views, admin).
STEWIE_ALLOWED_OPERATORS=mccardle.john@gmail.com,aaron.w.storey80@gmail.com,storeyaw@clarkson.edu
STEWIE_DIRECTORS=mccardle.john@gmail.com,aaron.w.storey80@gmail.com
