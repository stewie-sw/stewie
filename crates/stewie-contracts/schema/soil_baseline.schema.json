{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewie.space/schema/soil_baseline.schema.json",
  "title": "SoilBaseline",
  "description": "Regolith constants the body registry does not carry: the Janosi-Hanamoto shear modulus, the slip-sinkage coefficients, the density ladder (compacted, spoil, sintered, grain), the density transition depth, the median grain size, the ice ceiling and the dense-end strength of the material model. Each value keeps its honesty tag from stewie/specs/constants.py and a source note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "k_shear_m",
    "slip_c1",
    "slip_c2",
    "rho_deep",
    "rho_grain",
    "rho_spoil",
    "rho_sintered",
    "z_t_m",
    "d50_m",
    "w_ice_max",
    "phi_dense_deg",
    "cohesion_dense_pa"
  ],
  "properties": {
    "k_shear_m": {
      "$ref": "#/definitions/Tagged"
    },
    "slip_c1": {
      "$ref": "#/definitions/Tagged"
    },
    "slip_c2": {
      "$ref": "#/definitions/Tagged"
    },
    "rho_deep": {
      "$ref": "#/definitions/Tagged"
    },
    "rho_grain": {
      "$ref": "#/definitions/Tagged"
    },
    "rho_spoil": {
      "$ref": "#/definitions/Tagged"
    },
    "rho_sintered": {
      "$ref": "#/definitions/Tagged"
    },
    "z_t_m": {
      "$ref": "#/definitions/Tagged"
    },
    "d50_m": {
      "$ref": "#/definitions/Tagged"
    },
    "w_ice_max": {
      "$ref": "#/definitions/Tagged"
    },
    "phi_dense_deg": {
      "$ref": "#/definitions/Tagged"
    },
    "cohesion_dense_pa": {
      "$ref": "#/definitions/Tagged"
    }
  },
  "definitions": {
    "Tagged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "tag",
        "source"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tag": {
          "type": "string",
          "enum": [
            "MEASURED",
            "SOURCED",
            "FIXED",
            "CALIB",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
