{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://stewie.space/schema/package_manifest.schema.json",
 "title": "PackageManifest",
 "description": "An installable data package (navigator N11): terrain layers by priority and one ephemeris pack, every file pinned by size and sha256, every layer with its full source descriptor (navigator N31: source, version, provider, license, CRS and radius, resolution, role, quality layer, priority, hashes); its LOLA alignment (N32) is in the package's alignment.json. Paths are relative to the package directory. Written by pipeline/build_package.py; never hand-edited.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "name",
  "body",
  "layers",
  "ephemeris"
 ],
 "properties": {
  "format": {
   "const": "stewie-package-v1"
  },
  "name": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "body": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "layers": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/definitions/Layer"
   }
  },
  "ephemeris": {
   "$ref": "#/definitions/Ephemeris"
  }
 },
 "definitions": {
  "File": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "bytes",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "License": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "statement",
    "url"
   ],
   "properties": {
    "statement": {
     "type": "string",
     "minLength": 1
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    }
   }
  },
  "Layer": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "priority",
    "kind",
    "image",
    "label",
    "source",
    "version",
    "license",
    "resolution_m",
    "provider",
    "crs",
    "role",
    "quality"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "priority": {
     "type": "integer",
     "minimum": 1
    },
    "kind": {
     "enum": [
      "pds_simple_cylindrical",
      "pds_polar_stereographic"
     ]
    },
    "image": {
     "$ref": "#/definitions/File"
    },
    "label": {
     "$ref": "#/definitions/File"
    },
    "source": {
     "type": "string",
     "pattern": "^https://"
    },
    "version": {
     "type": "string",
     "minLength": 1
    },
    "license": {
     "$ref": "#/definitions/License"
    },
    "resolution_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "lat_min_deg": {
     "type": "number",
     "minimum": -90,
     "maximum": 90,
     "description": "For a whole-band layer: the latitude band the reader answers everywhere in (with lat_max_deg)."
    },
    "lat_max_deg": {
     "type": "number",
     "minimum": -90,
     "maximum": 90
    },
    "polar_box_m": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "number"
     },
     "description": "For a regional crop: [x0, y0, x1, y1] of its pixel-centre hull in polar-stereographic metres. A layer has either this or a latitude band, never both."
    },
    "provider": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "producer",
      "institution",
      "mission",
      "data_set"
     ],
     "properties": {
      "producer": {
       "type": "string",
       "minLength": 1
      },
      "institution": {
       "type": "string",
       "minLength": 1
      },
      "mission": {
       "type": "string",
       "minLength": 1
      },
      "data_set": {
       "type": "string",
       "minLength": 1
      }
     },
     "description": "Who made the source (navigator N31 descriptor), from its PDS label."
    },
    "crs": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "projection",
      "radius_m",
      "center_lat_deg",
      "center_lon_deg",
      "frame"
     ],
     "properties": {
      "projection": {
       "enum": [
        "simple_cylindrical",
        "polar_stereographic"
       ]
      },
      "radius_m": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "center_lat_deg": {
       "type": "number",
       "minimum": -90,
       "maximum": 90
      },
      "center_lon_deg": {
       "type": "number",
       "minimum": -360,
       "maximum": 360
      },
      "frame": {
       "type": "string",
       "minLength": 1
      }
     },
     "description": "The source's projection, reference sphere radius and body-fixed frame, from its label."
    },
    "role": {
     "enum": [
      "base",
      "regional",
      "local"
     ],
     "description": "Global base tier, regional (polar) tier, or a local crop around one site."
    },
    "quality": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "note"
     ],
     "properties": {
      "kind": {
       "enum": [
        "none"
       ]
      },
      "note": {
       "type": "string",
       "minLength": 1
      }
     },
     "description": "The source's quality layer; `none` when the package installs none (stated, never implied)."
    },
    "crop_of": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$",
     "description": "For a local crop: the layer whose bytes it is a window of (its LOLA alignment is the parent's)."
    }
   }
  },
  "Ephemeris": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "data",
    "header",
    "span_utc",
    "source",
    "license"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "data": {
     "$ref": "#/definitions/File"
    },
    "header": {
     "$ref": "#/definitions/File"
    },
    "span_utc": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "string"
     }
    },
    "source": {
     "type": "string",
     "minLength": 1
    },
    "license": {
     "$ref": "#/definitions/License"
    }
   }
  }
 }
}
